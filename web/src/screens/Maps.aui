Page Maps
  Stack variant=map-stage
    Section id=map
    Stack variant=floating-search
      Row variant=search-bar
        Icon name=MapPin size=28
        Button variant=search-entry action=openSearch aria-label="Search places"
          Text $searchText
        If condition=$showSearchReset
          Button variant=search-icon action=clearSearch aria-label="Clear search"
            Icon name=X size=24
        Else
          Button variant=avatar action=profile aria-label="Account and settings"
            Text $initial
      Row variant=category-chips
        If condition=$showTabs
          Button variant=chip action=home
            Icon name=House
            Text "Home"
        For each=$categories
          Button variant=$item.variant action=category item=$item.key
            Icon name=$item.icon
            Text $item.title
    Button variant=layers-control action=layers aria-label="Map downloads"
      Icon name=Download size=26
    Stack variant=map-controls
      Button variant=map-control action=locate aria-label="My location"
        Icon name=LocateFixed size=25
      Button variant=directions-control action=directions aria-label="Directions"
        Icon name=Navigation size=26
    Text variant=map-brand "My Maps"
    If condition=$measuring
      Row variant=measure-status
        Text $measurement
        Button variant=text action=measure "Done"
    Stack variant=$sheetVariant
      Button variant=sheet-handle action=expand aria-label=$expandLabel aria-expanded=$sheetExpanded
        Section variant=handle-line
      Row variant=sheet-heading
        If condition=$routing
          Button variant=search-icon action=clearSearch aria-label="Back to map"
            Icon name=ArrowLeft
        Stack variant=sheet-title
          Heading level=1 $title
          Text variant=sheet-hint $sheetHint
        If condition=$closable
          Button variant=round-action action=save aria-label="Save place"
            Icon name=Bookmark
          Button variant=round-action action=share aria-label="Share place"
            Icon name=Share2
          Button variant=search-icon action=deselect aria-label="Close place details"
            Icon name=X
      If condition=$selected
        Stack variant=place-summary
          Text variant=place-address $selected.address
          Text variant=caption $selected.categoryLabel
        Row variant=quick-actions
          Button variant=pill action=toSelected
            Icon name=CornerUpRight
            Text "Directions"
          Button variant=soft-pill action=quickStart
            Icon name=Navigation
            Text "Start"
          Button variant=soft-pill action=share
            Icon name=Share2
            Text "Share"
          Button variant=soft-pill action=save
            Icon name=Bookmark
            Text $saveLabel
      If condition=$routePreview
        Stack variant=route-preview
          Text variant=route-time $routePreviewTime
          Text variant=caption $routePreviewSummary
          Row variant=quick-actions
            Button variant=pill action=navigate
              Icon name=Navigation
              Text $navigationLabel
            Button variant=soft-pill action=addStops
              Icon name=CirclePlus
              Text "Add stops"
            Button variant=soft-pill action=shareRoute
              Icon name=Share2
              Text "Share"
      If condition=$navigationActive
        Card variant=navigation-cue
          Icon name=$navigationIcon size=28
          Heading level=2 $nextInstruction
          Text $remainingLabel
          If condition=$offRoute
            Button variant=pill action=reroute "Update route from here"
          Button variant=soft-pill action=navigate "Exit navigation"
      Stack variant=sheet-content
        If condition=$exploringNearby
          If condition=$hasResults
            Row variant=results-heading
              Text variant=caption $resultCaption
              Spacer
              Button variant=text action=refresh "Search this area"
            Stack variant=place-results
              For each=$results
                Row variant=place-result-row
                  Button variant=place-result action=place item=$item.key
                    Icon name=$item.icon size=23
                    Stack variant=result-copy
                      Heading level=2 $item.name
                      Text variant=caption $item.address
                      Text variant=place-meta $item.meta
                  Button variant=list-save action=saveResult item=$item.key aria-label=$item.saveAria
                    Icon name=$item.saveIcon size=23
                    Text $item.saveLabel
            Button variant=see-more action=expand $seeMoreLabel
          Else
            Stack variant=explore-empty
              If condition=$attempted
                Text $emptyMessage
                Button variant=see-more action=refresh "Try again"
              Else
                Card variant=discover-intro
                  Icon name=Utensils size=32
                  Heading level=2 "Find your local favourites"
                  Text "Discover somewhere to eat, shop or explore around this map."
                  Button variant=pill action=restaurants "Find restaurants"
          Heading level=2 "Explore nearby"
          Grid variant=explore-grid columns=2
            For each=$exploreCategories
              Button variant=explore-tile action=category item=$item.key
                Icon name=$item.icon
                Text $item.title
          Text variant=caption "Place details from OpenStreetMap. Coverage varies by area."
        If condition=$overviewExploring
          Card
            Heading level=2 "Your local overview"
            Text "Search towns and mapped names, save places, or install street detail for nearby places."
            Button variant=soft-pill action=mapInstall "Map downloads"
        If condition=$saving
          Text "Your places, all together. Save a place on the map to build your own lists."
          Row variant=saved-shortcuts
            Button variant=shortcut action=home
              Icon name=House
              Text "Home"
            Button variant=shortcut action=work
              Icon name=BriefcaseBusiness
              Text "Work"
            Button variant=shortcut action=exportPlaces
              Icon name=Download
              Text "Export"
          If condition=$noPlaces
            Card variant=empty-places
              Icon name=Bookmark size=36
              Heading level=2 "Keep the places you love"
              Text "Choose a place and tap Save to add it to a list."
          For each=$places
            Row variant=saved-place
              Button variant=result action=savedPlace item=$item.id
                Icon name=MapPin
                Stack
                  Text $item.name
                  Text variant=caption $item.list
              Button variant=search-icon action=editSaved item=$item.id aria-label="Change saved place list"
                Icon name=Bookmark
              Button variant=search-icon action=deletePlace item=$item.id aria-label="Delete saved place"
                Icon name=Trash2
        If condition=$contributing
          Card variant=contribute-intro
            Icon name=MapPinned size=42
            Heading level=2 "Help make the map better"
            Text "Add a missing place or correct details with the OpenStreetMap community."
            Link variant=button href=$editURL external=true "Edit this area"
            Link href="https://www.openstreetmap.org/fixthemap" external=true "Report a map problem"
          Heading level=2 "Your place notes"
          Text "Choose a place on the map, save it, and add your own private notes."
          Button variant=pill action=explore "Choose a place"
        If condition=$planning
          Row variant=travel-modes
            For each=$modes
              Button variant=$item.variant action=mode item=$item.key aria-pressed=$item.active
                Icon name=$item.icon
                Text $item.label
          If condition=$needsDirections
            Section id=directions-download
          Stack variant=route-inputs
            Row
              Icon name=CircleDot
              Input name=startQuery placeholder="Choose starting point" action=findStart
              Button variant=search-icon action=useLocation aria-label="Use my location as start"
                Icon name=LocateFixed
              Button variant=search-icon action=findStart aria-label="Find starting point"
                Icon name=Search
            Row
              Icon name=MapPin
              Input name=endQuery placeholder="Choose destination" action=findEnd
              Button variant=search-icon action=findEnd aria-label="Find destination"
                Icon name=Search
            For each=$routeResults
              Button variant=result action=routePlace item=$item.key
                Text $item.name
                Text variant=caption $item.address
          Row variant=route-options-heading
            Button variant=option-chip action=routeOptions aria-expanded=$optionsOpen
              Icon name=Settings2
              Text "Options & vehicle"
            Button variant=text action=swapStops "Swap"
            Button variant=text action=clearStops "Clear"
          If condition=$optionsOpen
            Card variant=route-options
              Field label=$vehicleLabel
                Select name=vehicle options=$vehicles
              If condition=$driving
                Field label="Route preference"
                  Select name=preference options=$preferences
                Checkbox name=avoidTolls label="Avoid tolls"
                Checkbox name=avoidMotorways label="Avoid motorways"
                Checkbox name=avoidUnpaved label="Avoid unpaved roads"
                Text variant=caption "Vehicle type adjusts the local energy model. Battery range and charging stops are not calculated."
              Checkbox name=alternatives label="Show alternative routes"
          For each=$stops
            Row variant=stop
              Text $item.label
              Spacer
              Button variant=search-icon action=removeStop item=$item.key aria-label="Remove stop"
                Icon name=X
          If condition=$routeBusy
            Row variant=calculating-route
              Spinner
              Text "Calculating on your server..."
              Button variant=text action=cancelRoute cancel=true "Cancel"
          Else
            Button variant=pill action=route disabled=$cannotRoute "Find routes"
          If condition=$hasRoutes
            Stack variant=route-choices
              For each=$routes
                Button variant=$item.variant action=chooseRoute item=$item.key aria-pressed=$item.active
                  Icon name=Route
                  Stack
                    Text variant=route-time $item.time
                    Text variant=caption $item.summary
            Text variant=caption $arrivalLabel
            Row variant=route-actions
              Button variant=pill action=navigate
                Icon name=Navigation
                Text $navigationLabel
              Button variant=soft-pill action=addStops
                Icon name=CirclePlus
                Text "Add stops"
              Button variant=soft-pill action=shareRoute
                Icon name=Share2
                Text "Share"
              Button variant=soft-pill action=exportRoute
                Icon name=Download
                Text "GPX"
            Text variant=caption "Estimates exclude live traffic and road closures. Navigation needs location permission and works while this page is open."
            Heading level=2 "Directions"
            For each=$steps
              Row variant=step
                Icon name=$item.icon
                Text $item.instruction
                Spacer
                Text variant=caption $item.distance
          Else
            Text variant=caption "Choose a start and destination, or use your current location. To add more stops, choose a place on the map and tap Add stop."
        If condition=$selected
          Card variant=place-detail
            Row
              Icon name=MapPin
              Text $selected.coordinates
            If condition=$selected.hours
              Row
                Icon name=Clock
                Text $selected.hours
            If condition=$selected.website
              Link href=$selected.website external=true "Visit website"
            If condition=$selected.phone
              Link href=$selected.callURL $selected.phone
            If condition=$selected.osm
              Link href=$selected.osm external=true "Place details on OpenStreetMap"
            Row
              Button variant=text action=start "Set start"
              Button variant=text action=stop "Add stop"
              Button variant=text action=measure "Measure distance"
            If condition=$selected.list
              Text variant=caption "Saved in $selected.list"
            If condition=$selected.notes
              Text $selected.notes
            Button variant=pill action=save "Save to a list"
    If condition=$showTabs
      Row variant=bottom-tabs
        Button variant=$exploreVariant action=explore
          Icon name=MapPin size=25
          Text "Explore"
        Button variant=$savedVariant action=saved
          Icon name=Bookmark size=25
          Text "You"
        Button variant=$contributeVariant action=contribute
          Icon name=CirclePlus size=25
          Text "Contribute"
    If condition=$searchOpen
      Stack variant=search-view aria-label="Place search"
        Row variant=search-editor
          Button variant=search-icon action=closeSearch aria-label="Back to map"
            Icon name=ArrowLeft size=24
          Input name=query placeholder="Search here" aria-label="Search places" action=search autoFocus=true enterKeyHint=search
          If condition=$searchHasQuery
            Button variant=search-icon action=clearQuery aria-label="Clear query"
              Icon name=X
          Button variant=search-icon action=search aria-label="Submit search"
            Icon name=Search size=23
        If condition=$searchHeading
          Stack variant=shortcut-intent
            Heading level=2 $searchHeading
            Text variant=caption $shortcutHint
        Row variant=search-shortcuts
          Button variant=search-shortcut action=home
            Icon name=House size=24
            Stack
              Text "Home"
              Text variant=caption $homeLabel
          Button variant=search-shortcut action=work
            Icon name=BriefcaseBusiness size=24
            Stack
              Text "Work"
              Text variant=caption $workLabel
          Button variant=search-shortcut action=coordinates
            Icon name=LocateFixed size=24
            Text "Coordinates"
        Stack variant=search-scroll
          If condition=$showRecent
            Row variant=recent-heading
              Heading level=2 "Recent"
              Spacer
              If condition=$hasRecents
                Button variant=text action=clearRecents "Clear all"
            If condition=$hasRecents
              Stack variant=recent-list
                For each=$recents
                  Row variant=search-result-row
                    Button variant=search-result action=recentSearch item=$item.key
                      Icon name=History size=23
                      Stack variant=result-copy
                        Text $item.title
                        Text variant=caption $item.address
                    If condition=$item.saveable
                      Button variant=list-save action=saveRecent item=$item.key aria-label=$item.saveAria
                        Icon name=Bookmark size=23
                        Text "Save"
            Else
              Text variant=caption "Your searches and chosen places appear here. History stays private on this server."
          Else
            For each=$localSuggestions
              Button variant=search-result action=savedPlace item=$item.id
                Icon name=Bookmark size=23
                Stack variant=result-copy
                  Text $item.name
                  Text variant=caption $item.address
            If condition=$searchPending
              Row variant=search-status
                Spinner
                Text "Finding places..."
            For each=$suggestions
              Row variant=search-result-row
                Button variant=search-result action=suggestion item=$item.key
                  Icon name=MapPin size=23
                  Stack variant=result-copy
                    Text $item.name
                    Text variant=caption $item.address
                Button variant=list-save action=saveSuggestion item=$item.key aria-label=$item.saveAria
                  Icon name=$item.saveIcon size=23
                  Text $item.saveLabel
            If condition=$searchStatus
              Text variant=caption $searchStatus
  If condition=$profileOpen
    Card variant=dialog aria-label="Account and settings"
      Row
        Image src=$logo alt="My Maps" width=32 height=32
        Heading level=2 "My Maps"
        Spacer
        Button variant=search-icon action=closeOverlay aria-label="Close account menu"
          Icon name=X
      Row variant=profile-identity
        Icon name=CircleUserRound size=40
        Stack
          Heading level=2 $userName
          Text variant=caption $userEmail
      Button variant=menu-item action=saved
        Icon name=Bookmark
        Text "Your places"
      Button variant=menu-item action=mapInstall
        Icon name=Download
        Text "Map downloads"
      Button variant=menu-item action=measure
        Icon name=Ruler
        Text "Measure distance"
      Button variant=menu-item action=theme
        Icon name=SunMoon
        Text "Change appearance"
      Link variant=menu-item href="#settings"
        Icon name=Settings2
        Text "Settings and backups"
      If condition=$workspace
        Button variant=menu-item action=apps data-workspace-apps-trigger=true
          Icon name=Layers
          Text "Workspace apps"
      Divider
      Button variant=menu-item action=logout
        Icon name=LogOut
        Text "Sign out"
      Text variant=caption $versionText
  If condition=$coordinatesOpen
    Card variant=dialog aria-label="Find coordinates"
      Row
        Heading level=2 "Find coordinates"
        Spacer
        Button variant=search-icon action=closeOverlay aria-label="Close coordinates"
          Icon name=X
      Text "Enter latitude and longitude to open an exact location."
      Field label="Coordinates"
        Input name=coordinates placeholder="50.7829, -0.6731" action=goCoordinates
      Button variant=pill action=goCoordinates "Show on map"
  If condition=$saveOpen
    Card variant=dialog aria-label="Save place to list"
      Row
        Heading level=2 "Save to a list"
        Spacer
        Button variant=search-icon action=closeOverlay aria-label="Close save picker"
          Icon name=X
      Stack variant=save-place-summary
        Icon name=MapPin size=24
        Heading level=3 $saveTarget.name
        Text variant=caption $saveTarget.address
      If condition=$saveError
        Alert tone=error $saveError
      Field label="Choose a list"
        Select name=saveList options=$saveOptions
      If condition=$newListSelected
        Field label="New list name"
          Input name=newList placeholder="e.g. Weekend trips" maxLength=100 autoFocus=true action=confirmSave
      If condition=$shortcutReplacement
        Text variant=save-explanation $shortcutReplacement
      Field label="Private note (optional)"
        Input name=saveNotes multiline=true maxLength=10000
      If condition=$saveBusy
        Row
          Spinner
          Text "Saving place..."
      Row variant=save-picker-actions
        Button variant=soft-pill action=closeOverlay "Cancel"
        Button variant=pill action=confirmSave $saveConfirmLabel
