Page DirectionsInstall
  Card variant=directions-download
    Row
      Icon name=Route size=28
      Heading level=2 "Local directions"
    Text "Drive, walk and cycle using OpenStreetMap data stored on this server. No separate routing service is needed."
    If condition=$installed
      Text variant=route-ready $installedLabel
      Text variant=caption $installedSize
    If condition=$error
      Alert tone=error $error
    If condition=$owner
      If condition=$canPlan
        Field label="Directions coverage"
          Select name=coverage options=$coverages
        If condition=$area
          Grid columns=2
            Field label="Centre latitude"
              Input name=lat type=number min=-80 max=80 step=0.0001
            Field label="Centre longitude"
              Input name=lon type=number min=-180 max=180 step=0.0001
          Field label="Radius in kilometres (1–500)"
            Input name=radius type=number min=1 max=500
        Button variant=soft-pill action=check "Check directions download"
      If condition=$checking
        Row
          Spinner
          Text "Checking download size..."
      If condition=$plan
        Text $downloadLabel
        Text variant=caption $spaceLabel
        Text variant=caption "The download includes the local engine and road graph. Five-degree data tiles can extend beyond your chosen area."
        Button variant=pill action=install "Install local directions"
      If condition=$working
        Row
          Spinner
          Text $progressMessage
        Text variant=caption $progressBytes
        Button variant=soft-pill action=cancel cancel=true "Cancel directions download"
      Else
        Stack
          If condition=$progressMessage
            Text variant=caption $progressMessage
    Else
      Stack
        If condition=$needsInstall
          Text "The Workspace owner can install directions here for everyone on this server."
    Text variant=caption "Routes include estimates, alternatives and turn instructions. Live traffic, public transport, road closures and charging stops are not included."
